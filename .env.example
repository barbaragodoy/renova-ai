# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renovai
DB_USER=renovai
DB_PASSWORD=renovai

# LLM Provider (trocar entre: claude, openai, gemini, groq)
LLM_PROVIDER=claude
LLM_API_KEY=sua_chave_aqui
LLM_MODEL=claude-sonnet-4-6
GROQ_API_KEY=sua_chave_groq_aqui

# Autenticação
AUTH_PROVIDER=auth0
AUTH0_DOMAIN=seu_dominio.auth0.com
AUTH0_AUDIENCE=sua_audience_aqui
AUTH0_ALGORITHMS=RS256
AUTH0_CLIENT_ID=seu_client_id
AUTH0_CLIENT_SECRET=seu_client_secret

# Flag de dev: false aceita e-mail cru via query/body (sem token) — true exige
# Bearer token válido (Auth0/Entra ID). AUTH_EMAIL_CLAIM ainda não confirmada
# com Flávio (preferred_username vs upn) — trocável via env sem mudar código.
AUTH_REQUIRE_JWT=false
AUTH_EMAIL_CLAIM=preferred_username

# Ambiente (local ou producao)
ENV=local

# Fonte de dados (valores possíveis: local | databricks)
DATA_SOURCE=local

# Databricks — OAuth M2M via Service Principal (client_credentials). Nunca usar PAT.
# Preencher apenas quando DATA_SOURCE=databricks.
DATABRICKS_SERVER_HOSTNAME=adb-3551324376903721.1.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/783ae0217086255c
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CATALOG=acheinfo_dev
DATABRICKS_SCHEMA=renovai
GENIE_SPACE_ID=
