# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renovai
DB_USER=renovai
DB_PASSWORD=renovai

# LLM Provider (trocar entre: claude, openai, gemini)
LLM_PROVIDER=claude
LLM_API_KEY=sua_chave_aqui
LLM_MODEL=claude-sonnet-4-6

# Autenticação
AUTH_PROVIDER=auth0
AUTH0_DOMAIN=seu_dominio.auth0.com
AUTH0_CLIENT_ID=seu_client_id
AUTH0_CLIENT_SECRET=seu_client_secret

# Ambiente (local ou producao)
ENV=local

# Databricks (preenchido só em produção)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
GENIE_SPACE_ID=
