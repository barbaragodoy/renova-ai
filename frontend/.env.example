# Base das chamadas de API.
# Deixe vazio: o portal é servido pelo próprio FastAPI, então as chamadas são
# de mesma origem. Em desenvolvimento o proxy do Vite cuida do encaminhamento.
VITE_API_BASE_URL=

# Modo de autenticação da tela de login. Precisa acompanhar AUTH_MODE do
# backend.
#   (vazio) ou senha -> e-mail corporativo + senha
#   entra_id         -> acesso pela conta corporativa Microsoft
VITE_AUTH_MODE=

# Destino do proxy de desenvolvimento, quando o backend não estiver na
# porta padrão 8000.
VITE_BACKEND_URL=
